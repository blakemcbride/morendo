#!/usr/bin/env bash
# Starts Morendo:  ./morendo -shell   (interactive CLIPS shell)
#                  ./morendo -gui     (Swing GUI)
# Works from a checkout after "./bld build" (target/<module>/classes) and from an unpacked
# distribution (module jars in libs/). Logging options: see log4j2.xml in the core jar.
DIR="$(cd "$(dirname "$0")" && pwd)"
CP="$DIR/libs/*"
for d in "$DIR"/target/*/classes; do
    [ -d "$d" ] && CP="$d:$CP"
done
exec java -Xms256m -Xmx1g -cp "$CP" org.jamocha.Morendo "$@"
