<!-- SpotBugs filter for ./bld spotbugs. The generated CLIPS parser is not ours to fix. -->
<FindBugsFilter>
  <Match>
    <Class name="~org\.jamocha\.parser\.clips\.(CLIPSParser.*|ParseException|SimpleCharStream|Token|TokenMgrError)"/>
  </Match>
</FindBugsFilter>
